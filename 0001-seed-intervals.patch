@@ -0,0 +1,163 @@
+"""Seed-level 95% t-intervals for the LLM predictor tables (paper S2, S3, S10-S13).
+
+Reads only the bundled evidence packet (evidence/overleaf-table-evidence-reproducible-20261019-v2.zip)
+and its nested archives. No training, no fitting.
+
+Naming used by the original runs:
+  final_refit_7ep_v2/third-off-*  = two accuracies (third accuracy off), ZCPs on, seeds 42-44
+  final_refit_7ep_v2/third-on-*   = three accuracies, ZCPs on, seeds 42-44
+  *-layer = all seven layer features, *-no_layer = no layer features.
+Six-seed arms join seeds 42-44 with seeds 45-47 from the follow-up runs listed in ARMS.
+Interval: mean +/- t(0.975, n-1) * sd / sqrt(n), sd with ddof=1.
+"""
+import csv
+import io
+import json
+import math
+import tarfile
+import zipfile
+from pathlib import Path
+
+from scipy.stats import pearsonr, spearmanr, t as student_t
+
+PACKET = 'evidence/overleaf-table-evidence-reproducible-20261019-v2.zip'
+METRICS = [('RMSE', 'best_accuracy_rmse'), ('MAE', 'best_accuracy_mae'), ('Pearson', 'best_accuracy_pearson_r'),
+           ('Spearman', 'best_accuracy_spearman_r'), ('R2', 'best_accuracy_r2')]
+FEATURES = [('weightwatcher', 'WeightWatcher'), ('cka', 'CKA'), ('effective-rank', 'Effective rank'),
+            ('taylor', 'Taylor importance'), ('gradient-flow', 'Gradient flow'), ('sensitivity', 'Sensitivity'),
+            ('activation', 'Dead-act. fraction')]
+REFIT = 'main_115_record/out/accuracy_predictor_85_5_10/final_refit_7ep_v2/'
+T912 = 'tables9-12-seeds45-47-v1/results/'
+OFF = 'zcp-off-toggle-refit7-v1/results/'
+
+
+def _arms():
+    """(table, row label) -> (seed 42-44 run prefix, seed 45-47 run prefix). Prefix + '-sNN' is the run folder."""
+    arms = {}
+    for acc, third in (('2acc', 'third-off'), ('3acc', 'third-on')):
+        tab_on, tab_off = ('S10', 'S11') if acc == '2acc' else ('S12', 'S13')
+        ablation = ('layer-ablation-2acc-refit7-v1/results/2acc-' if acc == '2acc' else 'layer-ablation-refit7-v1/results/')
+        no_layer_hi = (T912 + '2acc-zcp-on-no-layer' if acc == '2acc'
+                       else 'zcp-on-no-layer-3acc-seeds45-47-v1/results/3acc-no-layer')
+        arms[(tab_on, 'No layer')] = (REFIT + third + '-no_layer', no_layer_hi)
+        arms[(tab_on, 'All seven')] = (REFIT + third + '-layer', T912 + acc + '-zcp-on-all-seven')
+        arms[(tab_off, 'No layer')] = (OFF + acc + '-no-layer', T912 + acc + '-zcp-off-no-layer')
+        arms[(tab_off, 'All seven')] = (OFF + acc + '-all-seven', T912 + acc + '-zcp-off-all-seven')
+        for key, label in FEATURES:
+            arms[(tab_on, label)] = (ablation + key, T912 + acc + '-zcp-on-' + key)
+            hi = ('taylor-3acc-zcp-off-seeds45-47-v1/results/3acc-taylor' if (acc, key) == ('3acc', 'taylor')
+                  else T912 + acc + '-zcp-off-' + key)
+            arms[(tab_off, label)] = (OFF + acc + '-' + key, hi)
+        n = '2 accuracy' if acc == '2acc' else '3 accuracy'
+        arms[('S3', n + ' + all seven')] = arms[(tab_on, 'All seven')]
+        arms[('S3', n + ' + no layer')] = arms[(tab_on, 'No layer')]
+    return arms
+
+
+ARMS = _arms()
+# S2 pilot: three refits per arm on the 22 matched test records; metrics recomputed from test_predictions.csv, t with df=2.
+PILOT = {
+    '2 accuracy + layer': ['historical-2acc-reproduction-v2/results/layer-r%d' % i for i in (1, 2, 3)],
+    '2 accuracy + no layer': ['historical-2acc-reproduction-v2/results/no-layer-r1',
+                              'historical-2acc-reproduction-v2/results/no-layer-r2',
+                              'historical-22test-additions-v1/results/2acc-no-layer-r3'],
+    '3 accuracy + layer': ['historical-22test-additions-v1/results/3acc-layer-r%d' % i for i in (1, 2, 3)],
+    '3 accuracy + no layer': ['historical-22test-additions-v1/results/3acc-no-layer-r%d' % i for i in (1, 2, 3)],
+}
+
+
+def _walk(name, data, out, depth=0):
+    buf = io.BytesIO(data)
+    if zipfile.is_zipfile(buf):
+        z = zipfile.ZipFile(buf)
+        for n in z.namelist():
+            _handle(n, lambda n=n: z.read(n), out, depth)
+        return
+    try:
+        tf = tarfile.open(fileobj=io.BytesIO(data))
+    except tarfile.TarError:
+        return
+    for m in tf.getmembers():
+        if m.isfile():
+            _handle(m.name, lambda m=m: tf.extractfile(m).read(), out, depth)
+
+
+def _handle(name, get, out, depth):
+    if name.endswith(('test_metrics.json', 'test_predictions.csv')):
+        out.setdefault(name, get())
+    elif name.endswith(('.zip', '.tar', '.tar.gz', '.tgz')) and depth < 5:
+        _walk(name, get(), out, depth + 1)
+
+
+def load(root):
+    files = {}
+    _walk(PACKET, (Path(root) / PACKET).read_bytes(), files)
+    return files
+
+
+def _find(files, run, suffix):
+    hits = sorted({v for k, v in files.items() if k.endswith(run + '/' + suffix)})
+    if not hits:
+        raise KeyError('Missing run in evidence packet: ' + run)
+    if len(hits) > 1:
+        raise ValueError('Conflicting copies of run: ' + run)
+    return hits[0]
+
+
+def _interval(values):
+    n = len(values)
+    mean = sum(values) / n
+    sd = math.sqrt(sum((v - mean) ** 2 for v in values) / (n - 1))
+    half = student_t.ppf(0.975, n - 1) * sd / math.sqrt(n)
+    return mean, mean - half, mean + half
+
+
+def _prediction_metrics(data):
+    pairs = [(float(r['pred_best_accuracy']), float(r['gt_best_accuracy']))
+             for r in csv.DictReader(io.StringIO(data.decode()))]
+    pred, gt = zip(*pairs)
+    n = len(gt)
+    mean_gt = sum(gt) / n
+    sse = sum((p - g) ** 2 for p, g in pairs)
+    return dict(RMSE=math.sqrt(sse / n), MAE=sum(abs(p - g) for p, g in pairs) / n,
+                Pearson=float(pearsonr(pred, gt)[0]), Spearman=float(spearmanr(pred, gt)[0]),
+                R2=1 - sse / sum((g - mean_gt) ** 2 for g in gt))
+
+
+def compute(files):
+    rows = []
+    for (table, label), (lo, hi) in ARMS.items():
+        seeds = [json.loads(_find(files, '%s-s%d' % (lo, s), 'test_metrics.json')) for s in (42, 43, 44)]
+        seeds += [json.loads(_find(files, '%s-s%d' % (hi, s), 'test_metrics.json')) for s in (45, 46, 47)]
+        row = dict(table=table, row=label, n=6, seeds_42_44=lo, seeds_45_47=hi)
+        for name, key in METRICS:
+            row[name], row[name + '_lo'], row[name + '_hi'] = _interval([float(d[key]) for d in seeds])
+        rows.append(row)
+    for label, runs in PILOT.items():
+        per_run = [_prediction_metrics(_find(files, r, 'test_predictions.csv')) for r in runs]
+        row = dict(table='S2', row=label, n=3, seeds_42_44=';'.join(runs), seeds_45_47='')
+        for name, _ in METRICS:
+            row[name], row[name + '_lo'], row[name + '_hi'] = _interval([m[name] for m in per_run])
+        rows.append(row)
+    return rows
+
+
+def run(root, out):
+    out.mkdir(parents=True)
+    rows = compute(load(root))
+    fields = ['table', 'row', 'n'] + [x for name, _ in METRICS for x in (name, name + '_lo', name + '_hi')] + ['seeds_42_44', 'seeds_45_47']
+    with open(out / 'seed_intervals.csv', 'w', newline='', encoding='utf-8') as fh:
+        w = csv.DictWriter(fh, fieldnames=fields)
+        w.writeheader()
+        for r in rows:
+            w.writerow({k: (round(v, 6) if isinstance(v, float) else v) for k, v in r.items()})
+    md = ['# Seed-level 95% t-intervals', '']
+    for table in ('S2', 'S3', 'S10', 'S11', 'S12', 'S13'):
+        md += ['## ' + table, '', '| Row | ' + ' | '.join(n for n, _ in METRICS) + ' |', '|---' * 6 + '|']
+        for r in rows:
+            if r['table'] == table:
+                md.append('| %s | ' % r['row'] + ' | '.join('%.4f [%.4f, %.4f]' % (r[n], r[n + '_lo'], r[n + '_hi']) for n, _ in METRICS) + ' |')
+        md.append('')
+    (out / 'seed_intervals.md').write_text('\n'.join(md), encoding='utf-8')
+    print('COMPLETE: %d rows -> %s' % (len(rows), out / 'seed_intervals.csv'), flush=True)
+    return rows
