+import unittest
+from pathlib import Path
+
+from analysis import revision_seed_intervals as R
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+@unittest.skipUnless((ROOT / R.PACKET).is_file(), 'evidence packet not present')
+class SeedIntervalTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.rows = {(r['table'], r['row']): r for r in R.compute(R.load(ROOT))}
+
+    def check(self, table, row, metric, mean, lo, hi):
+        r = self.rows[(table, row)]
+        for got, want in ((r[metric], mean), (r[metric + '_lo'], lo), (r[metric + '_hi'], hi)):
+            self.assertAlmostEqual(got, want, delta=5e-5)
+
+    def test_coverage(self):
+        self.assertEqual(len(self.rows), 44)
+        self.assertEqual({t for t, _ in self.rows}, {'S2', 'S3', 'S10', 'S11', 'S12', 'S13'})
+
+    def test_main_arms(self):
+        self.check('S3', '2 accuracy + all seven', 'RMSE', 11.3987, 10.4335, 12.3639)
+        self.check('S3', '2 accuracy + no layer', 'RMSE', 12.7138, 11.3178, 14.1098)
+        self.check('S3', '3 accuracy + all seven', 'R2', 0.8272, 0.8204, 0.8341)
+        self.check('S3', '3 accuracy + no layer', 'RMSE', 9.1098, 8.7658, 9.4539)
+
+    def test_feature_tables(self):
+        self.check('S10', 'WeightWatcher', 'RMSE', 14.7550, 13.9175, 15.5925)
+        self.check('S12', 'Gradient flow', 'RMSE', 8.7890, 8.4614, 9.1166)
+        self.check('S12', 'Taylor importance', 'RMSE', 8.9553, 8.8224, 9.0881)
+
+    def test_pilot(self):
+        self.check('S2', '3 accuracy + layer', 'RMSE', 6.7903, 5.6441, 7.9366)
+        self.check('S2', '2 accuracy + layer', 'MAE', 8.3071, 4.8684, 11.7459)
+
+
+if __name__ == '__main__':
+    unittest.main()
